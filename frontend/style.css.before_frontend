:root{--ink:#16232f;--muted:#5d6b78;--bg:#e9eff3;--panel:#fff;--line:#cfd9e0;--accent:#1d6a8a;--accent-ink:#fff;
--up:#a8431f;--down:#2c7a3f;--warn-bg:#fff3d1;--warn-ink:#5c4400;--err:#b3261e;--shadow:0 1px 2px rgba(22,35,47,.08)}
@media (prefers-color-scheme:dark){:root{--ink:#e8eef2;--muted:#9aaab6;--bg:#0f1a22;--panel:#17252f;--line:#2b3d4a;--accent:#5bb4d6;
--accent-ink:#06202b;--up:#f0a182;--down:#7fd197;--warn-bg:#3a2f0b;--warn-ink:#f3dca0;--err:#ff8d85}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.top{padding:2rem 1rem 1rem;max-width:68rem;margin:0 auto}
h1{margin:0;font-size:clamp(1.6rem,4vw,2.4rem);line-height:1.15;letter-spacing:-.02em}
.top p{margin:.4rem 0 0;color:var(--muted)}
h2{font-size:1.1rem;margin:0 0 1rem}h3{font-size:1rem;margin:1.5rem 0 .5rem}
.layout{display:grid;gap:1rem;max-width:68rem;margin:0 auto;padding:1rem;grid-template-columns:minmax(0,22rem) minmax(0,1fr);align-items:start}
@media (max-width:760px){.layout{grid-template-columns:1fr}}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1.25rem;box-shadow:var(--shadow)}
.field{margin-bottom:.9rem}.row{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
label{display:block;font-weight:600;font-size:.9rem;margin-bottom:.25rem}
input,select{width:100%;font:inherit;color:inherit;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:.55rem .65rem}
input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.invalid{border-color:var(--err)}
.err{display:block;min-height:1.1rem;color:var(--err);font-size:.82rem;margin-top:.15rem}
button{width:100%;font:inherit;font-weight:700;background:var(--accent);color:var(--accent-ink);border:0;border-radius:6px;padding:.75rem;cursor:pointer}
button:disabled{opacity:.6;cursor:progress}
.status{min-height:1.4rem;margin:.6rem 0 0;color:var(--muted);font-size:.9rem}
.alert{border-radius:6px;padding:.75rem 1rem;margin-bottom:1rem;background:var(--warn-bg);color:var(--warn-ink)}
.alert.error{background:transparent;color:var(--err);border:1px solid var(--err)}
.label{margin:0;color:var(--muted)}
.price{margin:.1rem 0 .9rem;font-size:clamp(2.2rem,6vw,3.4rem);font-weight:800;letter-spacing:-.03em;line-height:1.05;font-variant-numeric:tabular-nums}
.range{position:relative;height:8px;border-radius:4px;background:linear-gradient(90deg,var(--line),var(--accent),var(--line))}
.range span{position:absolute;top:-5px;width:4px;height:18px;border-radius:2px;background:var(--ink);transform:translateX(-50%)}
.bounds{display:flex;justify-content:space-between;margin:.35rem 0 1.25rem;color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:.75rem;margin:0 0 1rem}
.facts div{border-left:3px solid var(--accent);padding-left:.7rem}
.facts dt{color:var(--muted);font-size:.85rem}.facts dd{margin:0;font-weight:700;font-variant-numeric:tabular-nums}
.up{color:var(--up)}.down{color:var(--down)}
.badge{display:inline-block;padding:.1rem .6rem;border-radius:99px;background:var(--bg);border:1px solid var(--line);font-size:.85rem;font-weight:600}
.badge.live{border-color:var(--down);color:var(--down)}
.muted{color:var(--muted);font-size:.88rem}
.warnings{margin:.75rem 0 0;padding:.6rem .6rem .6rem 1.6rem;border-radius:6px;background:var(--warn-bg);color:var(--warn-ink)}
.warnings:empty{display:none}
.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:.5rem .6rem;border-bottom:1px solid var(--line);white-space:nowrap}
th{color:var(--muted);font-size:.82rem;font-weight:600}
a{color:var(--accent)}
.foot{max-width:68rem;margin:0 auto;padding:1rem 1rem 2rem;color:var(--muted);font-size:.85rem}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
