<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Оценка квартиры в Алматы</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="top">
  <h1>Сколько стоит квартира в Алматы</h1>
  <p>Оценка по реальным объявлениям krisha.kz</p>
</header>

<main class="layout">
  <form id="form" class="panel" novalidate>
    <h2>Параметры квартиры</h2>
    <div class="field"><label for="district">Район</label>
      <select id="district" name="district" required><option value="">Загрузка…</option></select>
      <span class="err" data-for="district"></span></div>
    <div class="field"><label for="area_total">Общая площадь, м²</label>
      <input id="area_total" name="area_total" type="number" step="0.1" inputmode="decimal" required>
      <span class="err" data-for="area_total"></span></div>
    <div class="row">
      <div class="field"><label for="floor">Этаж</label>
        <input id="floor" name="floor" type="number" step="1" inputmode="numeric" required>
        <span class="err" data-for="floor"></span></div>
      <div class="field"><label for="floor_total">Этажей в доме</label>
        <input id="floor_total" name="floor_total" type="number" step="1" inputmode="numeric" required>
        <span class="err" data-for="floor_total"></span></div>
    </div>
    <div class="field"><label for="house_year">Год постройки</label>
      <input id="house_year" name="house_year" type="number" step="1" inputmode="numeric" required>
      <span class="err" data-for="house_year"></span></div>
    <div class="field"><label for="building_type">Тип дома</label>
      <select id="building_type" name="building_type" required><option value="">Загрузка…</option></select>
      <span class="err" data-for="building_type"></span></div>
    <button id="submit" type="submit">Рассчитать стоимость</button>
    <p id="status" class="status" role="status" aria-live="polite"></p>
  </form>

  <section id="result" class="panel" aria-live="polite" hidden>
    <div id="alert" class="alert" role="alert" hidden></div>
    <div id="output" hidden>
      <p class="label">Ориентировочная стоимость</p>
      <p id="price" class="price"></p>
      <div class="range" aria-hidden="true"><span id="marker"></span></div>
      <p class="bounds"><span id="low"></span><span id="high"></span></p>
      <dl class="facts">
        <div><dt>Цена за м²</dt><dd id="ppm2"></dd></div>
        <div><dt>Медиана района за м²</dt><dd id="median"></dd></div>
        <div><dt>К медиане района</dt><dd id="diff"></dd></div>
      </dl>
      <p><span id="badge" class="badge"></span> <span id="rows" class="muted"></span></p>
      <ul id="warnings" class="warnings"></ul>
      <h3>Похожие объявления</h3>
      <div class="scroll"><table>
        <thead><tr><th>Цена</th><th>Площадь</th><th>Этаж</th><th>Год</th><th>Район</th><th></th></tr></thead>
        <tbody id="comps"></tbody>
      </table></div>
      <p id="quality" class="muted"></p>
    </div>
  </section>
</main>

<footer class="foot">Оценка ориентировочная и не является официальной оценкой стоимости недвижимости.</footer>
<script src="/static/app.js"></script>
</body>
</html>
